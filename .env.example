# ============================================
# 📈 Stock Alert Telegram Bot - Environment Config
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Telegram Bot Token (REQUIRED)
# Get from @BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Check interval in seconds (default: 3600 = 1 hour)
# How often the bot scans subscribed stocks for technical events
CHECK_INTERVAL=3600

# SQLite Database Path (relative to project root)
DB_PATH=data/stock_bot.db